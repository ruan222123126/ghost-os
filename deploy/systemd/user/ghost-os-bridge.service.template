[Unit]
Description=Ghost-OS Bridge
After=network-online.target
Wants=network-online.target
PartOf=ghost-os.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
Environment=HOME=%h
EnvironmentFile=-%h/.config/ghost-os/autostart.env
ExecStart=__ROOT__/scripts/autostart/start-bridge.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true

[Install]
WantedBy=ghost-os.target
