{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost-os.dev/schemas/bus-envelope.schema.json",
  "title": "Ghost-OS Bus Contract",
  "description": "Single source of truth for cross-process request/response envelopes and core action schemas.",
  "oneOf": [
    {
      "$ref": "#/$defs/requestEnvelope"
    },
    {
      "$ref": "#/$defs/responseEnvelope"
    }
  ],
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "PING",
        "AGENT_SEND",
        "HUMAN_RESPONSE",
        "CONFIG_GET",
        "CONFIG_UPDATE",
        "MEMORY_QUERY",
        "MEMORY_ARCHIVE",
        "LIST_FILES",
        "BASH_EXEC",
        "SCRIPT_EXEC",
        "SCREEN_SHOT",
        "MOUSE_CLICK",
        "BROWSER_QUERY"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ]
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "params",
        "trace_id"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "params": {
          "type": "object"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "payload",
        "error"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "payload": {
          "type": "object"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "scriptExecParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script"
      ],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "default": 30000
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 256
        }
      }
    },
    "scriptExecPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "tool_calls_log"
      ],
      "properties": {
        "output": {
          "type": "string"
        },
        "tool_calls_log": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "x-ghost-os": {
    "version": "1.0",
    "tool_surface": {
      "tools.bash_exec": "Execute shell command; stdout is auto-truncated for long output",
      "tools.list_files": "List entries in a directory",
      "tools.read_file": "Read file with optional line range (max 200 lines per call)",
      "tools.write_file": "Write or append file content (max 1MB per call)",
      "tools.apply_diff": "Apply unified diff text to a file",
      "tools.search_files": "Regex search across files, returns grep-style matches",
      "tools.fetch_webpage": "Fetch HTTPS webpage and return cleaned markdown"
    }
  }
}
