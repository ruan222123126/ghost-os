          "type": "string",
          "minLength": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "default": 30000
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 256
