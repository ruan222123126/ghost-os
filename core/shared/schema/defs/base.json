{
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "AGENT_SEND",
        "AGENT_STOP",
        "HUMAN_RESPONSE",
        "CONFIG_GET",
        "CONFIG_UPDATE",
        "TASK_CREATE",
        "TASK_LIST",
        "TASK_GET",
        "TASK_UPDATE",
        "TASK_RUN_NOW",
        "TASK_LOGS",
        "TASK_DELETE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ]
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "params",
        "trace_id"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "params": {
          "type": "object"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "payload",
        "error"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "payload": {
          "type": "object"
        },
        "error": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "providerType": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "custom",
        "codex"
      ]
    }
  }
}
