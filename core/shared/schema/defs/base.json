{
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "PING",
        "AGENT_SEND",
        "AGENT_STOP",
        "HUMAN_RESPONSE",
        "CONFIG_GET",
        "CONFIG_UPDATE",
        "TASK_CREATE",
        "TASK_LIST",
        "TASK_SYSTEM_LIST",
        "TASK_GET",
        "TASK_UPDATE",
        "TASK_RUN_NOW",
        "TASK_LOGS",
        "TASK_DELETE",
        "RSS_INBOX_POLL",
        "RSS_INBOX_LIST",
        "RSS_INBOX_GET",
        "RSS_INBOX_GROUPS",
        "RSS_BRIEFING_BUILD",
        "RSS_BRIEFING_GET",
        "LIST_FILES",
        "READ_FILE",
        "SEARCH_FILES",
        "APPLY_DIFF",
        "EXPORT_FILE",
        "BASH_EXEC",
        "SCRIPT_EXEC",
        "SCREEN_CAPTURE",
        "IMAGE_CROP",
        "OCR_IMAGE",
        "TEMPLATE_MATCH_IMAGE",
        "TEXT_INPUT",
        "KEY_HOTKEY",
        "MOUSE_CLICK",
        "MOUSE_DOUBLE_CLICK",
        "MOUSE_RIGHT_CLICK",
        "MOUSE_DRAG",
        "MOUSE_SCROLL",
        "ACTIVE_WINDOW_INFO",
        "CODEX_CLI_START",
        "CODEX_CLI_STATUS"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ]
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "params",
        "trace_id"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "params": {
          "type": "object"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "payload",
        "error"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "payload": {
          "type": "object"
        },
        "error": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "providerType": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "custom",
        "codex"
      ]
    }
  }
}
