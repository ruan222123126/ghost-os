{
  "$defs": {
    "taskCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string"
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cron_expr": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "taskIDRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taskPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "schedule_type",
        "enabled",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string"
        },
        "schedule_type": {
          "type": "string",
          "enum": [
            "interval",
            "cron"
          ]
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cron_expr": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "last_run_at": {
          "type": "string"
        },
        "next_run_at": {
          "type": "string"
        },
        "last_error": {
          "type": "string"
        }
      }
    },
    "taskDeletePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deleted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "deleted": {
          "type": "boolean"
        }
      }
    }
  }
}
